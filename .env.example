################### Development Runtime Images ######################
DOZZLE_IMAGE="amir20/dozzle:latest"
PYTHON_IMAGE="docker.io/python:3.13-bullseye"

DOTNET_SDK_8_IMAGE="mcr.microsoft.com/dotnet/sdk:8.0"
DOTNET_SDK_9_IMAGE="mcr.microsoft.com/dotnet/sdk:9.0"
DOTNET_ASPNET_8_IMAGE="mcr.microsoft.com/dotnet/aspnet:8.0"
DOTNET_ASPNET_9_IMAGE="mcr.microsoft.com/dotnet/aspnet:9.0"

##########################################################

# Configs for Neo4j
NEO4J_IMAGE="docker.io/neo4j:2026-community"
NEO4J_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD="your-secure-neo4j-password"
NEO4J_DBMS_MEMORY_PAGECACHE_SIZE=512M

################### Postgres configs ######################
POSTGRES_DOCKER_IMAGE="docker.io/postgres:17-alpine"
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD="your-secure-postgres-password"
POSTGRES_DB=postgres
POSTGRES_INITDB_ARGS="-c max_prepared_transactions=100"

################### PgVector configs ######################
PGVECTOR_DOCKER_IMAGE="docker.io/pgvector/pgvector:pg18-trixie"
PGVECTOR_PORT=5433
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD="your-secure-pgvector-password"
PGVECTOR_DB=postgres

################### Elasticsearch server configs ######################
ELASTICSEARCH_IMAGE="docker.elastic.co/elasticsearch/elasticsearch:9.5.5"
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD="your-secure-elasticsearch-password"

################### Kibana configs ######################
KIBANA_IMAGE="docker.io/library/kibana:9.5.5"
KIBANA_PORT=5601

################### Nginx configs ######################
NGINX_IMAGE="nginx:stable-alpine"
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

################### Grafana configs ######################
GRAFANA_IMAGE="grafana/grafana:latest"
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD="your-secure-grafana-password"

################### Redis server configs ######################
REDIS_DOCKER_IMAGE="docker.io/redis:8-alpine"
REDIS_IMAGE="docker.io/redis:8-alpine"
REDIS_PORT=6379
REDIS_SERVER_STACK_DOCKER_IMAGE="docker.io/redis/redis-stack-server:8-alpine"
REDIS_UI_PORT=8001

################### RabbitMQ server configs ######################
RABBITMQ_DOCKER_IMAGE="docker.io/rabbitmq:4.4-management-alpine"
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

RMQ_USERNAME=rmquser
RMQ_PASSWORD="your-secure-rabbitmq-password"

################### Mongo server configs ######################
MONGO_DOCKER_IMAGE="mongodb/mongodb-community-server:9.0-ubi8-slim"
MONGO_PORT=27017
MONGO_USERNAME=mongoadmin
MONGO_PASSWORD="your-secure-mongodb-password"

################### N8N Agent Workflow server configs ######################
N8N_DOCKER_IMAGE="n8nio/n8n:2.28.2-amd64"
N8N_PORT=5678
POSTGRES_N8N_SCHEMA=n8n

################### RustFS Server configs ######################
RUSTFS_DOCKER_IMAGE="rustfs/rustfs:latest"
RUSTFS_PORT=9000

############### Ollama Server configs ######################
OLLAMA_DOCKER_IMAGE="ollama/ollama:latest"
OLLAMA_PORT=11434

OLLAMA_WEBUI_DOCKER_IMAGE="ghcr.io/open-webui/open-webui:main"
OLLAMA_WEBUI_PORT=8080

############### Ontotext GraphDB configs####################

GRAPHDB_DOCKER_IMAGE="ontotext/graphdb:11.5.1"
GRAPHDB_PORT=7200

############### LLM Configs (Ollama Cloud) ######################
# Get your API key from: https://ollama.com/api
LLM_API="https://ollama.com/api"
LLM_API_KEY="your-ollama-cloud-api-key-here"

LLM_DEFAULT_MODEL="qwen3.8:latest"
LLM_EMBEDDING_MODEL="qwen3-embedding:8b"
LLM_RERANKING_MODEL="dengcao/Qwen3-Reranker-4B:Q4_K_M"

############### Hindsight configs ######################
HINDSIGHT_DOCKER_IMAGE="ghcr.io/vectorize-io/hindsight:latest"
HINDSIGHT_PORT=8080
HINDSIGHT_POSTGRES_DB=postgres
HINDSIGHT_POSTGRES_SCHEMA=hindsight
HINDSIGHT_POSTGRES_USER=hindsight_user
HINDSIGHT_POSTGRES_PASSWORD="your-secure-hindsight-password"

############################################################

TIMEZONE=UTC+05:30
